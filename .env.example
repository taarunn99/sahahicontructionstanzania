# Copy to .env.local and fill in. Anything prefixed NEXT_PUBLIC_ is exposed to
# the browser - never put a secret behind that prefix.

# Canonical origin, used for metadataBase, canonical URLs and OG image URLs.
NEXT_PUBLIC_SITE_URL="https://www.sahihicc.com"

# Contact form delivery (server-only). Get a free key at resend.com.
# Without it the form falls back to FormSubmit, then shows the direct email.
RESEND_API_KEY=""
# Optional verified sender, e.g. "Sahihi Website <no-reply@sahihicc.com>".
CONTACT_FROM=""
